@{
    ViewData["Title"] = "ورود";
}

<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .moiauth-scope {
        --teal-950: #0a3d3d;
        --teal-800: #0e5e5c;
        --teal-600: #12807a;
        --teal-500: #16968f;
        --teal-100: #e6f4f2;
        --teal-50:  #f4faf9;
        --gold-700: #a8791f;
        --gold-500: #c9a24a;
        --gold-300: #e4c98a;
        --ink-900: #17272a;
        --ink-500: #5c7377;
        --ink-300: #9db0b2;
        --white: #ffffff;
        --danger-bg: #fdeeee;
        --danger-border: #f3c9c9;
        --danger-text: #a13636;

        font-family: 'Vazirmatn', Tahoma, sans-serif !important;
    }

    .moiauth-scope, .moiauth-scope * {
        box-sizing: border-box;
    }

    .moiauth-page {
        min-height: 100vh;
        width: 100%;
        display: flex !important;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background:
            radial-gradient(circle at 15% 10%, rgba(18, 128, 122, 0.07), transparent 40%),
            radial-gradient(circle at 85% 90%, rgba(201, 162, 74, 0.08), transparent 45%),
            #ffffff !important;
        position: relative;
        overflow: hidden;
    }

    .moiauth-page::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(135deg, rgba(18,128,122,0.05) 1px, transparent 1px),
            linear-gradient(45deg, rgba(18,128,122,0.05) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: radial-gradient(circle at 50% 40%, black, transparent 72%);
        pointer-events: none;
    }

    .moiauth-container {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
        z-index: 1;
    }

    .moiauth-card {
        width: 100%;
        max-width: 440px;
        background: var(--white) !important;
        border-radius: 28px;
        box-shadow:
            0 1px 2px rgba(15, 60, 60, 0.04),
            0 24px 48px -12px rgba(15, 60, 60, 0.16),
            0 0 0 1px rgba(15, 60, 60, 0.04);
        overflow: hidden;
        animation: moiauth-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @@keyframes moiauth-rise {
        from { opacity: 0; transform: translateY(18px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .moiauth-crest {
        position: relative;
        height: 132px;
        background: linear-gradient(160deg, var(--teal-800) 0%, var(--teal-600) 55%, var(--teal-500) 100%) !important;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .moiauth-crest svg.moiauth-pattern {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0.5;
    }

    .moiauth-emblem {
        position: relative;
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: var(--white) !important;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(10, 61, 61, 0.35), 0 0 0 6px rgba(255,255,255,0.14);
    }

    .moiauth-emblem svg {
        width: 34px;
        height: 34px;
    }

    .moiauth-body {
        padding: 34px 36px 32px;
        text-align: center;
    }

    .moiauth-title {
        margin: 0 0 8px !important;
        font-size: 22px !important;
        font-weight: 800 !important;
        color: var(--ink-900) !important;
        letter-spacing: -0.01em;
    }

    .moiauth-subtitle {
        margin: 0 0 26px !important;
        font-size: 14px !important;
        line-height: 1.9;
        color: var(--ink-500) !important;
        font-weight: 400 !important;
    }

    .moiauth-alert {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        text-align: right;
        background: var(--danger-bg) !important;
        border: 1px solid var(--danger-border);
        color: var(--danger-text) !important;
        border-radius: 14px;
        padding: 12px 14px;
        font-size: 13.5px;
        margin-bottom: 22px;
        animation: moiauth-shake 0.5s ease;
    }

    @@keyframes moiauth-shake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-4px); }
        40% { transform: translateX(4px); }
        60% { transform: translateX(-2px); }
        80% { transform: translateX(2px); }
    }

    .moiauth-providers {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .moiauth-btn {
        position: relative;
        display: flex !important;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none !important;
        width: 100%;
        background: linear-gradient(135deg, var(--teal-600), var(--teal-800)) !important;
        color: var(--white) !important;
        font-size: 15px;
        font-weight: 600;
        padding: 15px 20px;
        border-radius: 16px;
        border: 1px solid transparent;
        box-shadow: 0 10px 24px -8px rgba(14, 94, 92, 0.55);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        overflow: hidden;
        isolation: isolate;
    }

    .moiauth-btn::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--gold-500), var(--gold-300));
        opacity: 0;
        transition: opacity 0.25s ease;
        z-index: -1;
    }

    .moiauth-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px -10px rgba(168, 121, 31, 0.5);
        color: var(--white) !important;
    }

    .moiauth-btn:hover::before {
        opacity: 1;
    }

    .moiauth-btn:active {
        transform: translateY(0);
    }

    .moiauth-btn:focus-visible {
        outline: 3px solid var(--gold-300);
        outline-offset: 2px;
    }

    .moiauth-btn .moiauth-icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    .moiauth-footer {
        margin-top: 26px;
        padding-top: 20px;
        border-top: 1px solid var(--teal-100);
    }

    .moiauth-link {
        color: var(--ink-500) !important;
        font-size: 13.5px;
        text-decoration: none !important;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .moiauth-link:hover {
        color: var(--teal-600) !important;
    }

    @@media (max-width: 480px) {
        .moiauth-body { padding: 28px 22px 26px; }
        .moiauth-title { font-size: 19px !important; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .moiauth-card, .moiauth-alert { animation: none; }
        .moiauth-btn { transition: none; }
    }
</style>

<div class="moiauth-scope moiauth-page">
    <div class="moiauth-container">
        <div class="moiauth-card">

            <div class="moiauth-crest">
                <svg class="moiauth-pattern" viewBox="0 0 440 132" preserveAspectRatio="xMidYMid slice">
                    <defs>
                        <pattern id="moiauth-girih" width="44" height="44" patternUnits="userSpaceOnUse" patternTransform="rotate(0)">
                            <g stroke="#C9A24A" stroke-width="1" fill="none" opacity="0.55">
                                <rect x="12" y="12" width="20" height="20" transform="rotate(45 22 22)"></rect>
                                <rect x="12" y="12" width="20" height="20"></rect>
                            </g>
                        </pattern>
                    </defs>
                    <rect width="440" height="132" fill="url(#moiauth-girih)"></rect>
                </svg>
                <div class="moiauth-emblem">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L4 5.5V11c0 5 3.4 9.2 8 10.5 4.6-1.3 8-5.5 8-10.5V5.5L12 2z"
                              stroke="#0e5e5c" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M9 12.2l2.1 2.1 4-4.3" stroke="#c9a24a" stroke-width="1.8"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>

            <div class="moiauth-body">
                <h1 class="moiauth-title">سامانه احراز هویت</h1>
                <p class="moiauth-subtitle">جهت ورود به سامانه از یکی از روش‌های زیر استفاده کنید</p>

                @if (!string.IsNullOrEmpty(Context.Request.Query["error"]))
                {
                    <div class="moiauth-alert">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="flex-shrink:0;margin-top:1px;">
                            <circle cx="12" cy="12" r="9" stroke="#a13636" stroke-width="1.6"/>
                            <path d="M12 8v5" stroke="#a13636" stroke-width="1.6" stroke-linecap="round"/>
                            <circle cx="12" cy="16" r="1" fill="#a13636"/>
                        </svg>
                        <span>@Context.Request.Query["error"]</span>
                    </div>
                }

                <div class="moiauth-providers">
                    <a href="@Url.Action("redirect", "account", new { provider = "moi", returnUrl = ViewBag.ReturnUrl })"
                       class="moiauth-btn">
                        <svg class="moiauth-icon" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2L4 5.5V11c0 5 3.4 9.2 8 10.5 4.6-1.3 8-5.5 8-10.5V5.5L12 2z"
                                  stroke="white" stroke-width="1.6" stroke-linejoin="round"/>
                        </svg>
                        ورود با پنجره ملی خدمات وزارت کشور
                    </a>
                </div>

                <div class="moiauth-footer">
                    <a href="@ViewBag.ReturnUrl" class="moiauth-link">بازگشت به سامانه</a>
                </div>
            </div>

        </div>
    </div>
</div>
